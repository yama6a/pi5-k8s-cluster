# The committed version recipe, sourced by lib/shell/common.sh alongside the gitignored .env.
# To bump: edit here, or let renovate do it (renovate.json5 customManagers).

## Capped by the pinned Talos release's k8s default; raising it past that makes upgrade-k8s reject it.
# renovate: datasource=github-releases depName=kubernetes/kubernetes
KUBERNETES_VERSION="1.36.3"

## The Pi 5 Talos image release: 03b flashes its raw image, 03f upgrades nodes to its installer.
## Built by github.com/yama6a/talos-raspberry-pi5. `<talos version>-<build revision>`, and common.sh derives
## TALOS_VERSION (the talosctl client and expected server version) from the part before the dash.
## The custom versioning treats the build revision as a 4th component, not a semver prerelease, which
## renovate would otherwise skip as unstable.
# renovate: datasource=github-releases depName=yama6a/talos-raspberry-pi5 versioning=regex:^v(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)-(?<build>\d+)$
TALOS_IMAGE_RELEASE="v1.13.7-1"
